#!/usr/bin/env php
<?php
$root = dirname(__DIR__);
require $root.'/html/include/config.php';
require $root.'/html/include/tgid_store.php';

function usage() {
    fwrite(STDERR, "Usage: tgmanager-passwd [--delete] [--file FILE] [--password PASSWORD] <user>\n");
    exit(1);
}

function prompt_hidden($prompt) {
    fwrite(STDERR, $prompt);
    $line = '';
    if (strncasecmp(PHP_OS, 'WIN', 3) === 0) {
        $line = fgets(STDIN);
    } else {
        $stty = shell_exec('stty -g 2>/dev/null');
        if ($stty) {
            shell_exec('stty -echo 2>/dev/null');
            $line = fgets(STDIN);
            shell_exec('stty '.$stty.' 2>/dev/null');
            fwrite(STDERR, "\n");
        } else {
            $line = fgets(STDIN);
        }
    }
    if ($line === false) {
        return '';
    }
    return rtrim($line, "\r\n");
}

function read_users($path) {
    $users = array();
    if (!is_file($path)) {
        return $users;
    }
    $lines = file($path, FILE_IGNORE_NEW_LINES);
    if ($lines === false) {
        return $users;
    }
    foreach ($lines as $line) {
        $line = trim(str_replace("\r", '', $line));
        if ($line === '' || $line[0] === '#') {
            continue;
        }
        $pos = strpos($line, ':');
        if ($pos === false || $pos === 0) {
            continue;
        }
        $users[substr($line, 0, $pos)] = substr($line, $pos + 1);
    }
    return $users;
}

function write_users($path, $users) {
    $dir = dirname($path);
    if (!is_dir($dir) && !@mkdir($dir, 0755, true)) {
        fwrite(STDERR, "Cannot create directory: ".$dir."\n");
        return false;
    }
    $body = '';
    foreach ($users as $name => $hash) {
        $body .= $name.':'.$hash."\n";
    }
    if (@file_put_contents($path, $body) === false) {
        fwrite(STDERR, "Cannot write: ".$path."\n");
        return false;
    }
    @chmod($path, 0640);
    if (function_exists('posix_getgrnam') && function_exists('posix_chgrp')) {
        $gr = posix_getgrnam('www-data');
        if ($gr) {
            @posix_chgrp($path, $gr['gid']);
        }
    }
    return true;
}

$delete = false;
$file = '';
$password = null;
$user = '';
$args = array_slice($argv, 1);
while ($args) {
    $arg = array_shift($args);
    if ($arg === '-h' || $arg === '--help') {
        usage();
    } elseif ($arg === '--delete') {
        $delete = true;
    } elseif ($arg === '--file') {
        $file = $args ? array_shift($args) : '';
        if ($file === '') {
            usage();
        }
    } elseif ($arg === '--password') {
        $password = $args ? array_shift($args) : '';
        if ($password === null) {
            usage();
        }
    } elseif ($arg !== '' && $arg[0] === '-') {
        usage();
    } elseif ($user === '') {
        $user = $arg;
    } else {
        usage();
    }
}

if ($user === '' || strpos($user, ':') !== false) {
    usage();
}

$path = ($file !== '') ? $file : tgid_users_path();
$users = read_users($path);

if ($delete) {
    if (!isset($users[$user])) {
        fwrite(STDERR, "User not found: ".$user."\n");
        exit(1);
    }
    unset($users[$user]);
    if (!write_users($path, $users)) {
        exit(1);
    }
    echo "Deleted ".$user."\n";
    exit(0);
}

if ($password === null) {
    $password = prompt_hidden('Enter the password for '.$user.': ');
    $confirm = prompt_hidden('Confirm the password for '.$user.': ');
    if ($password === '' || $password !== $confirm) {
        fwrite(STDERR, "Passwords do not match.\n");
        exit(1);
    }
} elseif ($password === '') {
    fwrite(STDERR, "Password cannot be empty.\n");
    exit(1);
}

$users[$user] = password_hash($password, PASSWORD_DEFAULT);
if (!write_users($path, $users)) {
    exit(1);
}
echo "Updated ".$user." in ".$path."\n";
